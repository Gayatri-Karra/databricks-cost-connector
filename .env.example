# ==============================================================================
# Databricks Cost Connector Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your real credentials.
# DO NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Workspace Connection (Required for Workspace-level collection)
# Example AWS:   https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
# Example Azure: https://adb-1234567890123456.7.azuredatabricks.net
# Example GCP:   https://1234567890123456.7.gcp.databricks.com
DATABRICKS_HOST=https://dbc-sample-trial.cloud.databricks.com

# Personal Access Token (PAT) for workspace authentication
# Generate in Databricks Workspace -> User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Account-Level Authentication (Required for Account Billable Usage & Budgets APIs)
# Account ID can be found in the Databricks Accounts Console (top-right profile or URL)
DATABRICKS_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Optional: OAuth M2M (Service Principal) authentication for Account / Workspace APIs
# Recommended for production service account pipelines
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Optional: SQL Warehouse ID for querying Unity Catalog system tables
# (e.g. system.billing.usage and system.billing.list_prices)
# Found under SQL Warehouses -> Connection Details -> HTTP Path or Overview
DATABRICKS_WAREHOUSE_ID=

# Optional: Cloud provider override (AWS, AZURE, GCP). Auto-detected if omitted.
DATABRICKS_CLOUD_PROVIDER=AWS

# Output directory for raw payloads, normalized records, and coverage reports
OUTPUT_DIR=output

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

